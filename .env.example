# Copy to .env.local for `yarn dev` / `yarn build`. Both values are optional.
# NEXT_PUBLIC_* values are compiled into the build: change one, then build again.

# Public address of the site (no trailing slash), used for the canonical link
# and the social preview cards. Defaults to http://localhost:3030.
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# Base URL of the API that receives the contact form (no trailing slash).
# Leave empty to run without a back-end: the form then accepts the message locally.
NEXT_PUBLIC_API_BASE_URL=
